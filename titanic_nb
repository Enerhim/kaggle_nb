\",\"Don\",\"Dr\",\"Major\",\"Rev\",\"Sir\",\"Jonkheer\",\"Dona\"\n        ], \"Rare\")\n        \n        X[\"Title_Mrs\"] = (X[\"Title\"] == \"Mrs\").astype(int)\n        X[\"Title_Mr\"] = (X[\"Title\"] == \"Mr\").astype(int)\n        X[\"Title_Miss\"] = (X[\"Title\"] == \"Miss\").astype(int)\n        X[\"Title_Master\"] = (X[\"Title\"] == \"Master\").astype(int)\n        X[\"Title_Rare\"] = (X[\"Title\"] == \"Rare\").astype(int)\n        \n        age_medians = X.groupby(\"Title\")[\"Age\"].transform(\"median\")\n        X[\"Age\"] = X[\"Age\"].fillna(age_medians)\n        \n        # X[\"FamilySizeGroup\"] = pd.cut(X[\"FamilySize\"], bins=[0,1,4,10], labels=[0,1,2])\n        # X[\"AgeGroup\"] = pd.cut(X[\"Age\"], bins=[0,12,20,40,60,100], labels=[0,1,2,3,4])\n        # X[\"FareGroup\"] = pd.qcut(X[\"Fare\"], 4, labels=False)\n            \n        X[\"Child\"] = (X[\"Age\"] <= 13).astype(int)\n        X[\"WomanOrChild\"] = ((X[\"Child\"] == 1) | (X[\"Sex\"] == 1)).astype(int)\n        \n        return X[[\"CabinLetter\", \"Cabin\", \"Sex\", \"WomanOrChild\", \"Child\", \"Embarked_S\", \"Embarked_Q\", \"Embarked_C\", \"Fare\", \"Age\", \"FamilySize\", \"IsAlone\", \"Pclass\", \"SibSp\", \"Parch\", \"Title_Mrs\", \"Title_Mr\", \"Title_Master\", \"Title_Miss\", \"Title_Rare\"]]\n\n\nX_ = FeatureEngineering().transform(df_train)\nlen(X_.columns)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-21T12:41:01.163323Z","iopub.execute_input":"2026-03-21T12:41:01.163657Z","iopub.status.idle":"2026-03-21T12:41:01.223927Z","shell.execute_reply.started":"2026-03-21T12:41:01.163597Z","shell.execute_reply":"2026-03-21T12:41:01.222551Z"}},"outputs":[{"execution_count":2,"output_type":"execute_result","data":{"text/plain":"20"},"metadata":{}}],"execution_count":2},{"cell_type":"code","source":"optuna.logging.set_verbosity(optuna.logging.WARNING)\n\ny = df_train[\"Survived\"]\n\npruner = optuna.pruners.MedianPruner(\n    n_startup_trials=50,   # don't prune ea